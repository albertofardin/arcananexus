# Estrazione CSV del gestionale precedente "Nuova Frontiera": questi 5 CSV
# contengono dati personali reali (codice fiscale, password hash, email) e
# non devono mai essere committati. Le tabelle di catalogo nella stessa
# cartella non sono PII e vanno committate normalmente.
/gdxhisfn_NuovaFrontiera.csv/gdxhisfn_NuovaFrontiera_table_utenti.csv
/gdxhisfn_NuovaFrontiera.csv/gdxhisfn_NuovaFrontiera_table_personaggi.csv
/gdxhisfn_NuovaFrontiera.csv/gdxhisfn_NuovaFrontiera_table_png.csv
/gdxhisfn_NuovaFrontiera.csv/gdxhisfn_NuovaFrontiera_table_eventi_iscrizioni.csv
/gdxhisfn_NuovaFrontiera.csv/gdxhisfn_NuovaFrontiera_table_downtime.csv

# Regolamento PDF della stessa estrazione: asset binario, non codice/dati
# di catalogo, non va committato.
/gdxhisfn_NuovaFrontiera.csv/01.Regolamento.pdf
